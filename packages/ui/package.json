{
  "name": "@ar/ui",
  "version": "0.1.0",
  "description": "Variant-first React component library (CVA + Tailwind 4 + Radix primitives) with a dual-entry caching module (TanStack Query browser cache + Redis server cache).",
  "author": "Marcos Tomatti <marcostomatti.cv@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcostomatti/template-component-library.git"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./theme.css": "./dist/styles/tokens.css",
    "./fonts.css": "./dist/styles/fonts.css",
    "./cache": {
      "types": "./dist/cache/browser.d.ts",
      "import": "./dist/cache.js"
    },
    "./cache/server": {
      "types": "./dist/cache/server.d.ts",
      "import": "./dist/cache-server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "postbuild": "grep -q 'ioredis' ./dist/cache.js && { echo 'ERROR: ioredis leaked into the browser cache bundle' >&2; exit 1; } || exit 0",
    "dev": "vite --host",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "check-types": "tsc --noEmit",
    "lint": "eslint ./src --ext .ts,.tsx",
    "lint:fix": "eslint ./src --ext .ts,.tsx --fix",
    "pretest": "bun run build",
    "test": "vitest run --project unit",
    "test:full": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:visual": "scripts/test-visual.sh",
    "test:visual:update": "scripts/test-visual.sh --update",
    "check:stories": "node scripts/check-stories.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.20",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tanstack/react-query": "^5.80.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^7.5.1",
    "@storybook/addon-vitest": "~10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@storybook/test-runner": "^0.24.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/jest-image-snapshot": "^6.4.1",
    "@types/node": "^22.13.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsonc": "^3.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.2.0",
    "ioredis": "^5.0.0",
    "ioredis-mock": "^8.0.0",
    "@types/ioredis-mock": "^8.2.8",
    "jest-image-snapshot": "^6.5.2",
    "jsdom": "^29.1.1",
    "jsonc-eslint-parser": "^3.1.0",
    "playwright": "1.61.1",
    "playwright-core": "1.61.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "storybook": "^10.4.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^5.0.1",
    "vite-plugin-static-copy": "^4.1.0",
    "vitest": "^4.1.7",
    "vitest-browser-react": "^2.2.0",
    "wait-on": "^9.0.10"
  },
  "trustedDependencies": [
    "@swc/core",
    "unrs-resolver"
  ],
  "overrides": {
    "playwright": "1.61.1",
    "playwright-core": "1.61.1"
  }
}
