{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Dev tools",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "noImplicitOverride": true,
    "types": ["node"]
  },
  "include": ["src", "*.ts", "*.mjs"],
  "exclude": ["node_modules", "dist"]
}
