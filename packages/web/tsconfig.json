{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Web app",
  "extends": "@open-tomato/typescript-config/react",
  "compilerOptions": {
    // An app bundled by Vite: no declarations are ever emitted.
    "declaration": false,
    // Off for the same reason: nothing ships a .d.ts, so annotating every
    // export would buy no per-file declaration build.
    "isolatedDeclarations": false,
    "types": ["vite/client"]
  },
  "include": ["src", "tests", "*.ts", "*.tsx", "*.mjs"],
  "exclude": ["node_modules", "dist"]
}
