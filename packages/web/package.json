{
  "name": "@ar/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "predev": "bun run --filter '@ar/ui' build",
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "check-types": "tsc --noEmit",
    "lint": "eslint src tests *.ts *.mjs",
    "lint:fix": "eslint src tests *.ts *.mjs --fix",
    "pretest": "bun run --filter '@ar/ui' build",
    "test": "vitest run && playwright test"
  },
  "dependencies": {
    "@ar/ui": "workspace:*",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "tailwindcss": "^4",
    "vite": "^8.2.2",
    "vitest": "^4.1.7"
  }
}
