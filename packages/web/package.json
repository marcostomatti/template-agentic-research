{
  "name": "@ar/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "predev": "bun run --filter '@ar/ui' --filter '@ar/dev-tools' build",
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "check-types": "tsc --noEmit",
    "lint": "eslint src tests *.ts *.mjs",
    "lint:fix": "eslint src tests *.ts *.mjs --fix",
    "pretest": "bun run --filter '@ar/ui' --filter '@ar/dev-tools' build",
    "test": "vitest run && playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots=changed",
    "test:integration": "playwright test --config playwright.integration.config.ts"
  },
  "dependencies": {
    "@ar/ui": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ar/dev-tools": "workspace:*",
    "@axe-core/playwright": "^4.13.0",
    "@open-tomato/typescript-config": "^0.1.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "1.61.1",
    "tailwindcss": "^4",
    "vite": "^8.3.0",
    "vitest": "^4.1.7"
  }
}
