# HTTP port the service listens on.
PORT=3000

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Postgres — the default datastore. This value matches docker-compose's dev
# instance (`bun db:start`). The live-test instance is a DIFFERENT database
# on 5433 (ar_live) and is set by `bun run test:live` — never point
# this at it.
DATABASE_URL=postgresql://ar:ar@localhost:5432/ar

# Redis — OFF by default. Uncomment to register the Redis dependency
# (start the instance with `docker compose --profile redis up -d`).
# REDIS_URL=redis://localhost:6379

# Bearer-token auth (RFC 7662 introspection) — OFF by default; both values
# are required to enable it. See src/auth/ and specs/auth-basic-strategy.md.
# AUTH_INTROSPECT_URL=http://localhost:3000/auth/introspect
# AUTH_INTROSPECT_SECRET=change-me-to-a-32+-character-random-secret

# n8n instance the operator commands talk to — OFF by default. `AR_N8N_URL`
# is the base URL of that instance's public REST API; `AR_N8N_API_KEY` is
# the key it issued for those commands to authenticate with. The running
# service opens neither, so leaving both unset changes nothing a boot does.
# Both are left valueless where every other entry here carries an example:
# this file is TRACKED and is copied verbatim by whoever stands the stack
# up, so a URL or a key written here follows the README onto every machine
# set up the same way. The values belong in `.env` (gitignored) or in the
# launching environment, never in a tracked file.
# AR_N8N_URL=
# AR_N8N_API_KEY=

# MCP entrypoint (src/mcp/index.ts): 'stdio' for Claude Desktop / MCP
# Inspector; unset for HTTP.
# MCP_TRANSPORT=stdio
