{
  "name": "@ar/service",
  "version": "0.1.0",
  "description": "Express + MCP service template: dependency-injected service core, Drizzle/Postgres by default, optional Redis, cron jobs, notification channel stubs, and an agent-loop toolkit.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcostomatti/template-service-express.git"
  },
  "author": "Marcos Tomatti <marcostomatti.cv@gmail.com>",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "start:mcp": "bun src/mcp/index.ts",
    "check-types": "tsc --noEmit",
    "lint": "eslint src lib tests scripts",
    "lint:fix": "eslint src lib tests scripts --fix",
    "pretest": "bun scripts/build-workflows.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "AR_LIVE_DATABASE_URL=postgresql://ar:ar@localhost:5433/ar_live vitest run tests/live",
    "stress:start": "docker compose --profile stress up -d --wait postgres-live",
    "stress:stop": "docker compose --profile stress rm --stop --force postgres-live",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun scripts/seed.ts",
    "approve": "bun scripts/approve.ts",
    "build:workflows": "bun scripts/build-workflows.ts",
    "deploy:external": "bun scripts/deploy-external.ts",
    "docs:generate": "typedoc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "pg": "^8.20.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@eslint/markdown": "^7.5.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.2.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/parser": "^8.54.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsonc": "^3.1.2",
    "globals": "^17.2.0",
    "jsonc-eslint-parser": "^3.1.0",
    "supertest": "^7.0.0",
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22"
  }
}
