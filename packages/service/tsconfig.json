{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Service",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "forceConsistentCasingInFileNames": true,
    "incremental": false,
    "lib": ["es2022"],
    "module": "es2022",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "lib", "tests", "scripts", "*.ts", "*.mjs"],
  "exclude": ["node_modules", ".tmp", "dist", ".docs"]
}
