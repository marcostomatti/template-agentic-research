{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Umbrella root (tools + root files)",
  // tooling: tools/ and the root config files never ship, so this check
  // runs without declarations or isolatedDeclarations.
  "extends": ["@open-tomato/typescript-config/bun", "@open-tomato/typescript-config/tooling"],
  "compilerOptions": {
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["tools", "*.ts", "*.mjs"],
  // *.test.ts is excluded from check-types (origin parity with the service
  // template — vitest executes them; tsc doesn't gate them). Burning this
  // down is tracked in .specs/test-type-checking.md.
  "exclude": ["node_modules", "packages", "**/*.test.ts"]
}
